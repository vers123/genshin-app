{
  "name": "genshin-app",
  "version": "1.1.0",
  "description": "Genshin Impact database search web application powered by genshin-db",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
