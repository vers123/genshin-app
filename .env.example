# Server port / 服务端口
PORT=3000

# Default result output language / 默认输出语言
RESULT_LANGUAGE=ChineseSimplified

# Query input languages (comma-separated) / 查询时允许的输入语言（逗号分隔）
QUERY_LANGUAGES=ChineseSimplified,English,Japanese,Korean

# Database viewer pagination defaults / 数据库百科默认分页
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=24
